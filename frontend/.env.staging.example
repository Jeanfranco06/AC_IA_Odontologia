# ==============================================================================
# CONFIGURACIÓN DE EJEMPLO DE VARIABLES FRONTEND PARA PREPRODUCCIÓN / STAGING
# NEXOSALUD — PORTAL PACIENTE Y ESPACIO CLÍNICO ODONTOLÓGICO
# ==============================================================================

# URL base del API Backend desplegado en entorno de Staging
VITE_API_URL=http://localhost:3001/api

# Modo de la aplicación Vite
VITE_APP_ENV=staging

# Habilitar telemetría e inspección en consola de staging (true/false)
VITE_ENABLE_DEBUG=false
