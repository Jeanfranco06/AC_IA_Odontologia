# Copiar a .env.principal.local SOLO después del despliegue autorizado.
NEXOSALUD_ENV=principal
OLTP_DATABASE=NexoSaludDB
MART_DATABASE=NexoSalud_Mart
# Credencial operacional dedicada, sin sysadmin; nunca la credencial de administración.
NEXOSALUD_OLTP_URL="sqlserver://SERVIDOR:1433;database=NexoSaludDB;user=CUENTA_OLTP;password=SECRET_EXTERNAL;encrypt=true;trustServerCertificate=false"
# Login diferente: SELECT únicamente de hechos, dimensiones y bitácora; sin EXECUTE/DML.
MART_READ_URL="sqlserver://SERVIDOR:1433;database=NexoSalud_Mart;user=CUENTA_BI_LECTURA;password=SECRET_EXTERNAL;encrypt=true;trustServerCertificate=false"
NEXOSALUD_PRINCIPAL_ENABLED=false
CUSTOMER_ALERT_SCHEDULER_ENABLED=false
AI_AGENT_LLM_ENABLED=false
AI_AGENT_EXTERNAL_DATA_AUTHORIZED=false
CUSTOMER_INSTITUTIONAL_KNOWLEDGE_ENABLED=false
# Firma procedente del gestor de secretos, no del repositorio.
AI_AGENT_SESSION_SECRET=
