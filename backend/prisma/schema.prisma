generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("SQLSERVER_URL")
}

model Etapas {
  id_etapa       Int            @id(map: "PK__Etapas__9927D0E8AC169DF8") @default(autoincrement())
  nombre         String         @unique(map: "UQ__Etapas__72AFBCC698A5F8BE") @db.VarChar(20)
