  CanalOrigen             Canales?                   @relation("CanalOrigen", fields: [id_canal_origen], references: [id_canal], onDelete: NoAction, onUpdate: NoAction, map: "FK_Personas_Canal")
  Etapa                   Etapas                     @relation(fields: [id_etapa_actual], references: [id_etapa], onUpdate: NoAction, map: "FK_Personas_Etapa")
