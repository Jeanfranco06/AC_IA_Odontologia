# ==============================================================================
# ARCHIVO DE CONFIGURACIÓN DE EJEMPLO PARA ENTORNO DE STAGING / PREPRODUCCIÓN
# NEXOSALUD — AGENTE INTELIGENTE CUSTOMER
# ==============================================================================
# NOTA DE SEGURIDAD:
# Este archivo es una plantilla de ejemplo. NUNCA coloque contraseñas reales ni
# claves secretas en este archivo. Cree una copia local con credenciales rotadas
# protegida por permisos de sistema operativo (por ejemplo: .env.staging.local).

NODE_ENV=staging
PORT=3001

# Cadena de conexión transaccional SQL Server Staging (Aislada de Producción)
DATABASE_URL="sqlserver://127.0.0.1:1433;database=NexoSaludDB_Staging;user=NexoSaludCustomerStaging;password=[STAGING_PASSWORD_ROTADA];encrypt=false;trustServerCertificate=true"

# Cadena de conexión analítica SQL Server Data Mart Staging
DATA_MART_DATABASE_URL="sqlserver://127.0.0.1:1433;database=NexoSalud_Mart_Staging;user=NexoSaludCustomerStaging;password=[STAGING_PASSWORD_ROTADA];encrypt=false;trustServerCertificate=true"

# Secretos criptográficos para sesiones y tokens de confirmación supervisada
SESSION_SECRET="staging-super-secret-session-key-customer-ai-2026-isolated"
AI_AGENT_SESSION_SECRET="staging-super-secret-session-key-customer-ai-2026-isolated"

# API Key de Gemini para el agente conversacional (Staging sandbox o simulador)
GEMINI_API_KEY="AIzaSy_STAGING_CONTROLLED_KEY_REDACTED"
GEMINI_MODEL="gemini-2.5-flash"

# Directorio de persistencia duradera para base documental RAG Lexical BM25
CUSTOMER_RAG_STORAGE_DIR="./storage/rag-staging"

# Nivel de logs y telemetría (info, warn, error, debug)
LOG_LEVEL="info"
